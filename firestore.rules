rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "sadityasingh7990@gmail.com" ||
        request.auth.token.email == "admin@ruhimperium.com"
      );
    }

    // 1. PUBLIC SITE CONTENT: Visitors can only READ. Only Admin can MODIFY or DELETE.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogArticles/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. ORDERS: Visitors can CREATE orders at checkout.
    // Individual order GET allowed for order tracking by customer with valid order ID.
    // LIST (streaming/reading all orders) is STRICTLY restricted to Admin!
    // UPDATE / DELETE strictly restricted to Admin!
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // 3. REVIEWS & PUBLIC BROADCAST: Visitors can read and post reviews.
    // Sensitive order documents are NEVER allowed in the public reviews collection!
    match /reviews/{reviewId} {
      allow read: if !reviewId.matches('^order_.*');
      allow create: if !reviewId.matches('^order_.*');
      allow update, delete: if isAdmin();
    }

    // 4. USERS: Profiles for registration and checkout
    // Single user profile retrieval and registration allowed.
    // Bulk listing of all user accounts is strictly restricted to Admin!
    match /users/{userId} {
      allow get, create, update: if true;
      allow list, delete: if isAdmin();
    }
  }
}

